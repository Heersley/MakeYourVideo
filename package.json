{
  "name": "makeyourvideo",
  "version": "1.2.0",
  "license": "MIT",
  "description": "MakeYourVideo: a silent, native-2K vertical explainer video framework (Remotion + Python + FFmpeg).",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "esbuild": "0.25.10",
    "semver": "7.7.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio examples/nim_game/src/entry.tsx",
    "build": "remotion bundle examples/nim_game/src/entry.tsx",
    "render:example": "remotion render examples/nim_game/src/entry.tsx NimCinema out/nim-cinema.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --x264-preset=slow --audio-bitrate=256k",
    "typecheck": "tsc --noEmit -p core/vibe/tsconfig.json",
    "test:js": "node --test tools/tests/vibe_core.cjs"
  }
}
