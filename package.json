  "license": "MIT",
  "description": "MakeYourVideo: a silent, native-2K vertical explainer video framework (Remotion + Python + FFmpeg).",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "scripts": {
    "dev": "remotion studio examples/nim_game/src/entry.tsx",
    "build": "remotion bundle examples/nim_game/src/entry.tsx",
    "render:example": "remotion render examples/nim_game/src/entry.tsx NimCinema out/nim-cinema.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --x264-preset=slow --audio-bitrate=256k"
  }
