{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "topic",
    "entry",
    "previewComposition",
    "fullComposition",
    "previewFrames",
    "sfx"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "previewFrames": {
      "type": "integer",
      "minimum": 1
    },
    "bgmGainDb": {
      "type": "number"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "publicDir": {
      "type": "string",
      "minLength": 1
    },
    "previewComposition": {
      "type": "string",
      "minLength": 1
    },
    "fullComposition": {
      "type": "string",
      "minLength": 1
    },
    "sfx": {
      "type": "string",
      "minLength": 1
    },
    "evidenceScript": {
      "type": "string",
      "minLength": 1
    },
    "bgm": {
      "type": "string",
      "minLength": 1
    },
    "licenseNote": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "pattern": "^vibe-[0-9]+[.][0-9]+$"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "scope",
          "value",
          "reason"
        ],
        "properties": {
          "rule": {
            "const": "beat_duration"
          },
          "scope": {
            "type": "string",
            "pattern": "^B[0-9]+$"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "coreSnapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "dependentRequired": {
    "bgm": [
      "licenseNote"
    ]
  }
}
